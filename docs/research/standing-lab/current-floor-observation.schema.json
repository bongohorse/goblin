{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "measurement_version",
    "geometry_time",
    "impulse_time",
    "dt",
    "bodies",
    "contacts"
  ],
  "properties": {
    "measurement_version": {
      "const": "current-geometry-interval-support-v2"
    },
    "geometry_time": {
      "const": "current_pose"
    },
    "impulse_time": {
      "enum": [
        "unmeasured",
        "last_completed_step"
      ]
    },
    "dt": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body_id",
          "collider_id",
          "current_geometry",
          "current_touching",
          "candidates",
          "solver_contacts",
          "interval_normal_impulse",
          "interval_vertical_mean_load",
          "query_geometry"
        ],
        "properties": {
          "body_id": {
            "type": "string"
          },
          "collider_id": {
            "type": "string"
          },
          "current_geometry": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "distance",
                  "body_point",
                  "floor_point",
                  "normal"
                ],
                "properties": {
                  "distance": {
                    "type": "number"
                  },
                  "body_point": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  },
                  "floor_point": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  },
                  "normal": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "current_touching": {
            "type": "boolean"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cached_distance",
                "local_body",
                "local_floor",
                "current_body_point",
                "current_floor_point",
                "current_anchor_gap",
                "interval_normal",
                "interval_normal_impulse"
              ],
              "properties": {
                "cached_distance": {
                  "type": "number"
                },
                "local_body": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "local_floor": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "current_body_point": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "current_floor_point": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "current_anchor_gap": {
                  "type": "number"
                },
                "interval_normal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "interval_normal_impulse": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "solver_contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cached_distance",
                "current_midpoint"
              ],
              "properties": {
                "cached_distance": {
                  "type": "number"
                },
                "current_midpoint": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "interval_normal_impulse": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "interval_vertical_mean_load": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "query_geometry": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "distance",
                  "body_point",
                  "floor_point",
                  "normal"
                ],
                "properties": {
                  "distance": {
                    "type": "number"
                  },
                  "body_point": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  },
                  "floor_point": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  },
                  "normal": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body_id",
          "collider_id",
          "point",
          "normal",
          "distance",
          "normal_impulse",
          "normal_load"
        ],
        "properties": {
          "body_id": {
            "type": "string"
          },
          "collider_id": {
            "type": "string"
          },
          "point": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "normal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "distance": {
            "type": "number"
          },
          "normal_impulse": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "normal_load": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
